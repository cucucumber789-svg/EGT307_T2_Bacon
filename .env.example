# Database
POSTGRES_USER=user          # PostgreSQL username
POSTGRES_PASSWORD=password  # PostgreSQL password
POSTGRES_DB=env_monitor     # PostgreSQL database name

# Telegram Notification Service
TELEGRAM_BOT_TOKEN=your_token_here  # Telegram bot token (from @BotFather)
TELEGRAM_CHAT_ID=your_chat_id_here  # Chat/group ID to send alerts to

# ML Alert Thresholds
ANOMALY_SCORE_THRESHOLD=0.05  # Max anomaly score to trigger Telegram notification (0.0 - 1.0)
